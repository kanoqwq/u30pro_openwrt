#!/bin/sh /etc/rc.common
START=11
USE_PROCD=1
start_service() {
    [ "$(cat /etc/mu300/model 2>/dev/null)" = f50pro ] || return 0
    procd_open_instance leds
    procd_set_param command /usr/sbin/f50pro-leds
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() { ubus send f50pro.config '{}'; }
service_triggers() { procd_add_reload_trigger wireless unisoc_modem system; }

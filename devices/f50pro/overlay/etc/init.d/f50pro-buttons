#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
    [ "$(cat /etc/mu300/model 2>/dev/null)" = f50pro ] || return 0
    procd_open_instance keys
    procd_set_param env MU300_SYSD_PARTS=keys
    procd_set_param command /usr/bin/ucode /opt/mu300/bin/mu300-sysd
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

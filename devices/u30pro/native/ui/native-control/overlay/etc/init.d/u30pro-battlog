#!/bin/sh /etc/rc.common
# Battery history for the screen and the web page; see /usr/share/u30pro/battery-log.uc.
START=96
STOP=12
USE_PROCD=1
start_service() {
	[ "$(cat /etc/mu300/model 2>/dev/null)" != f50pro ] || return 0
	[ "$(cat /sys/class/power_supply/u30pro-battery/type 2>/dev/null)" = Battery ] || return 0
	[ "$(cat /sys/class/power_supply/u30pro-battery/present 2>/dev/null)" != 0 ] || return 0
	umask 077
	procd_open_instance battlog
	procd_set_param command /usr/sbin/u30pro-battlog
	procd_set_param respawn 3600 10 5
	procd_close_instance
}

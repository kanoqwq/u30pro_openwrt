 bool "Unisoc Type-C support"
 depends on TYPEC && EXTCON && NVMEM
config UNISOC_USB_SC27XX_TYPEC
 bool "UMP9651 Type-C controller"
 depends on UNISOC_USB_TYPEC && MFD_SC27XX_PMIC && (!SUSPEND || U30PRO_KEXEC_BASE)
config UNISOC_BC1P2
 bool "Unisoc BC1.2 charger/data-port detection"
 depends on USB_PHY && EXTCON

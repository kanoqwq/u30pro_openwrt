#!/usr/bin/ucode
// Adapt the U30 Pro screen to MU300's existing owners/caches. No tty access.
import * as fs from 'fs';
import * as uloop from 'uloop';
import { connect } from 'ubus';
import { cursor } from 'uci';
import { info, status } from 'mu300.dash';
import * as client from 'mu300.wifi-native';
import { carrier_name } from 'mu300.carrier';

uloop.init();
const bus=connect(null,3), config=cursor();
if(!bus)die('Screen feed: ubus is unavailable\n');
let requested={}, timer, sms_reads={}, sms_open=null, sms_text=null;
function clean(v) { return replace(''+(type(v)=='bool'?(v?1:0):(v ?? '')) ,/[\r\n\t]/g,' '); }
function object(path) { try{return json(fs.readfile(path) || '{}');}catch(e){return {}; } }
function cell_status(view,cell,sig,wanted,slot) {
    let sim=view.modem?.sims?.[int(slot)];
    let state=sim?.slot===int(slot)?sim.state:'unknown';
    if(state=='absent')return 'waiting-sim';
    if(!view.modem?.alive)return 'modem-unavailable';
    if(state=='locked')return 'sim-locked';
    if(cell.cfun===0 || sig.cfun===0)return 'radio-off';
    if(view.wan.up)return 'connected';
    if(!wanted)return 'data-disabled';
    return state=='ready'?'dialing':'checking-sim';
}
function screen_data_slot(view,saved) {
    // The dashboard resolves the live WAN/owner selection. A saved preference
    // may still name the previous card while a switch is completing.
    let actual=view.modem?.data_sim;
    return actual===0 || actual===1?''+actual:saved=='1'?'1':'0';
}
function screen_sms(slot,bus,ack_visible) {
    let pending=sms_reads; sms_reads={};
    let sms=bus.call('mu300dash','sms_list',{page:'1',slot}) || {};
    let out={sms_slot:slot}, legacy_text={};
    // Keep the published legacy bulk-ack event working for existing add-ons;
    // the native reader uses the new explicit card/message request instead.
    if(ack_visible)for(let msg in slice(sms.msgs || [],0,6)) {
        if(lc(msg.status || '') in ['new','unread'])
            pending[slot+':'+msg.id]={slot,id:''+msg.id};
    }
    for(let key in keys(pending)) {
        let item=pending[key], body=null;
        try {body=bus.call('mu300dash','sms_show',{id:item.id,slot:item.slot});}catch(e){}
        if(body?.ok) {
            if(ack_visible && item.slot==slot)legacy_text[key]=body.text;
            if(sms_open?.key==key) {
                let text=body.text || '', start=index(text,'\n---\n');
                sms_text=start>=0?substr(text,start+5):text;
            }
        } else out.sms_error='短信读取失败，请稍后重试';
    }
    // Counts and unread dots must come from the backend AFTER mark-read.
    if(length(keys(pending))) {
        let fresh=bus.call('mu300dash','sms_list',{page:'1',slot});
        if(type(fresh?.msgs)=='array')sms=fresh;
    }
    out.sms_total=sms.total || 0;out.sms_unread=sms.unread || 0;
    for(let i=0;i<min(6,length(sms.msgs || []));i++) {
        let msg=sms.msgs[i], text=msg.preview;
        if(legacy_text[slot+':'+msg.id]!=null)text=legacy_text[slot+':'+msg.id];
        if(sms_open?.slot==slot && sms_open.id==''+msg.id && sms_text!=null)text=sms_text;
        out['sms_id.'+i]=''+msg.id;
        out['sms.'+i]=join('\t',map([msg.peer,msg.time,lc(msg.status || '') in ['new','unread']?1:0,text],clean));
    }
    return out;
}
function screen_data_cards(physical) {
    let mask=0;
    // Use only the current board owner's supported IDs, not its saved override.
    if(physical?.model=='u30pro' && physical.supported && type(physical.cards)=='array')
        for(let card in physical.cards)if(type(card)=='int' && card>=0 && card<4)mask |= 1<<card;
    let active=physical?.active_card;
    let known=type(active)=='int' && active>=0 && active<4 && (mask & (1<<active));
    return {data_card_mask:mask,data_card_current:known?active:-1,
        data_card_ready:physical?.ready && known?1:0};
}
function run() {
    let screen=bus.call('u30pro.panel','status',{}) || {}, req=requested;
    requested={};
    for(let name in ['wireless','unisoc_modem','network']) {config.unload(name);config.load(name);}
    let view=info(null,bus,config);
    let slot=screen_data_slot(view,config.get('unisoc_modem','main','data_sim'));
    let cached=status(slot,true,bus,config), cell=cached.cell || {}, sig=cached.sig || {};
    let sim={};
    try {sim=bus.call('mu300dash','sim_get',{}) || {};} catch(e) {}
    let relay=client.status(config,bus);
    let charge={};
    try { charge=bus.call('mu300-charge','get',{}) || {}; } catch(e) {}

    // Existing native screen data-toggle add-ons consume this public state.
    // It reflects the MU300 owner's choice; it never owns a physical channel.
    fs.mkdir('/run/u30pro-cellular',448);
    let data_iface=config.get('unisoc_modem','main','data_interface') || 'wan';
    let wanted=view.wan.autostart!==false && !fs.stat('/run/mu300-mobile-data-manual-down') &&
        config.get('network',data_iface,'disabled')!='1';
    let state=cell_status(view,cell,sig,wanted,slot), absent=state=='waiting-sim', linked=state=='connected';
    if(absent){cell={};sig={};}
    let lte=cell.lte || {}, nr=cell.nr || {};
    let public_status={state,connected:linked,
        interface:view.wan.device,address:absent?'':view.wan.ip4};
    // The published screen-data add-on checks the literal compact boolean.
    // ucode %J adds spaces, so keep this field in its native byte format.
    // wanted follows explicit user intent, not a temporary netifd teardown.
    fs.writefile('/run/u30pro-cellular/status.json.new',
        '{"desired_up":'+(wanted?'true':'false')+','+substr(sprintf('%J',public_status),1)+'\n');
    fs.rename('/run/u30pro-cellular/status.json.new','/run/u30pro-cellular/status.json');
    let data={cell_connected:linked,cell_state:state,
        ip:absent?'':view.wan.ip4,iface:view.wan.device,op:carrier_name(cell.operator),
        rat:nr.band!=null?'5G':lte.band!=null?'4G':'',have_sig:(nr.rsrp ?? lte.rsrp)!=null?1:0,
        kernel:view.kernel,slot:trim(fs.readfile('/run/mu300/linux-slot') || ''),
        version:trim(fs.readfile('/etc/mu300/image-version') || ''),
        ssid:view.wifi.ssid,psk:config.get('wireless',view.wifi.section || 'default_radio0','key') || '',
        wifi_band:view.wifi.band,channel:view.wifi.channel,wifi_enabled:view.wifi.enabled,
        wifi_active:view.wifi.up,nclients:view.wifi.clients_n,usb_up:view.net.usb0?.up || 0,
        // LTE may carry several component widths (e.g. 20M+20M); do not
        // squeeze that into the native single-carrier bandwidth index.
        lte_bw:lte.bw ? replace(lte.bw,/M/g,'')+' MHz':'',bw_idx:-1,
        nr_bw:nr.bw_mhz>0?nr.bw_mhz:0,
        admin_wifi:1,band:lte.band,pci:lte.pci,earfcn:lte.earfcn,rsrp:lte.rsrp,rsrq:lte.rsrq,sinr:lte.sinr,
        nr:nr.band!=null,nr_band:nr.band,nr_pci:nr.pci,nr_arfcn:nr.arfcn,nr_rsrp:nr.rsrp,nr_sinr:nr.sinr,
        relay_cfg:relay.cfg,relay_on:relay.enabled?1:0,relay_state:relay.state,relay_ssid:relay.ssid};
    // Missing readings must stay absent: the native decoder treats a supplied
    // numeric field as valid, and an empty string would become a false 0 dB.
    for(let key in ['sinr','nr_rsrp','nr_sinr'])if(data[key]==null)delete data[key];
    // The switch represents manual pause, never the charger's shared inhibit bit.
    data.chg_control_ok=charge.ok && charge.available?1:0;
    if(charge.ok) {
        data.chg_bypass=charge.paused?1:0;
        data.chg_limited=charge.stopped && charge.reason=='limit'?1:0;
        data.chg_pending=charge.pending?1:0;
    }
    for(let i=0;i<min(6,length(view.wifi.clients || []));i++) {
        let c=view.wifi.clients[i];data['cl.'+i]=join('\t',map([c.host || c.mac,c.ip,c.signal],clean));
    }
    let cards=screen_data_cards(sim.physical || {});
    for(let key in keys(cards))data[key]=cards[key];
    let sms=screen_sms(slot,bus,req.sms_ack);
    for(let key in keys(sms))data[key]=sms[key];
    // List fields are already sanitized individually; keep their TAB framing.
    for(let key in keys(data))if(!match(key,/^(cl|sms)\./))data[key]=clean(data[key]);
    bus.call('u30pro.panel','feed',{data});
    timer.set(screen.screen_on===false?15000:3000);
}
timer=uloop.timer(100,run);
const panel_events=bus.listener('u30pro.panel.request',(event,msg)=>{
    if(msg?.request=='sms_ack')requested.sms_ack=true;
    if(msg?.request=='sms_read' && type(msg.id)=='string' && match(msg.id,/^[0-9]{1,20}$/) && msg.slot in ['0','1']) {
        let key=msg.slot+':'+msg.id;
        if(length(keys(sms_reads))>=16 && sms_reads[key]==null)delete sms_reads[keys(sms_reads)[0]];
        sms_reads[key]={id:msg.id,slot:msg.slot};
        sms_open={key,id:msg.id,slot:msg.slot};sms_text=null;
    }
    if(msg?.request=='sms_close') {sms_open=null;sms_text=null;}
    timer.set(1);
});
const modem_events=bus.listener('mu300.modem.urc',(type,msg)=>{
    if(match(msg?.line || '',/^\+CMT/))timer.set(100);
});
const sim_events=bus.listener('mu300.sim-state',()=>timer.set(1));
const terminate=uloop.signal(15,()=>uloop.end()), interrupt=uloop.signal(2,()=>uloop.end());
uloop.run();

#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
    touch /run/stay
    /opt/mu300/bin/mu300-next-boot --rearm || return 1
    procd_open_instance auto-default
    procd_set_param command /usr/bin/ucode /usr/libexec/unisoc-boot-default /opt/mu300/bin/mu300-next-boot /etc/mu300/default-boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

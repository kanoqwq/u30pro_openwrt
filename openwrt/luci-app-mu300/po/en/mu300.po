msgid "状态看板"
msgstr "Dashboard"

msgid "蜂窝"
msgstr "Cellular"

msgid "接入点 APN"
msgstr "Access points (APN)"

msgid "网络锁定"
msgstr "Network locks"

msgid "短信"
msgstr "SMS"

msgid "短信转发"
msgstr "SMS forwarding"

msgid "流量池"
msgstr "Data plan"

msgid "AT 终端"
msgstr "AT terminal"

msgid "适配设置"
msgstr "Adapter settings"

msgid "设备管理"
msgstr "Device management"

msgid "CPU 设置"
msgstr "CPU settings"

msgid "SIM 卡管理"
msgstr "SIM management"

msgid "电池与电量"
msgstr "Battery & power"

msgid "电池历史"
msgstr "Battery history"

msgid "电池使用时间"
msgstr "On battery"

msgid "预估续航"
msgstr "Estimated time left"

msgid "自上次充满"
msgstr "Since last full charge"

msgid "自上次充电"
msgstr "Since last charge"

msgid "24 小时"
msgstr "24 hours"

msgid "7 天"
msgstr "7 days"

msgid "小时"
msgstr "h"

msgid "分钟"
msgstr "min"

msgid "已连接电源，未充电"
msgstr "Plugged in, not charging"

msgid "正在充电或已充满"
msgstr "Charging or full"

msgid "电池放电功率"
msgstr "Power drawn from the battery"

msgid "时间区间"
msgstr "Time range"

msgid "每分钟记录，保留最近 10 天；关机或缺失时段留空。功率和电流为电池净值，不是充电器输入值。"
msgstr "Recorded every minute, kept for 10 days. Off-device and missing periods stay blank. Power and current are net battery values, not charger input."

msgid "未检测到电池"
msgstr "No battery detected"

msgid "暂无历史记录，采集后自动显示"
msgstr "No history yet; new readings will appear automatically"

msgid "电池记录读取失败，请稍后重试"
msgstr "Could not read battery history; retry shortly"

msgid "连接电源时不估算续航"
msgstr "Not estimated while plugged in"

msgid "放电记录不足，暂不估算"
msgstr "More discharge history is needed"

msgid "按最近放电速度估算"
msgstr "Based on recent discharge"

msgid "暂无记录"
msgstr "No readings"

msgid "已更新"
msgstr "Updated"

msgid "2内置卡 + 2插拔卡"
msgstr "2 built-in SIMs + 2 removable SIMs"

msgid "2插拔卡"
msgstr "2 removable SIMs"

msgid "射频、锁定及 AT 查看仍按两个逻辑卡槽控制。"
msgstr "Radio, locks and AT views use the two logical SIM slots."

msgid "卡源组合"
msgstr "SIM source combination"

msgid "卡源"
msgstr "SIM source"

msgid "分别选择两个逻辑栈接入的卡源，重启后保留。卡源选择不改变默认上网卡或射频开关。"
msgstr "Choose the SIM source for each logical stack. Saved across reboots; this does not change the default data SIM or radio switches."

msgid "应用卡源组合"
msgstr "Apply SIM sources"

msgid "应用卡源组合？"
msgstr "Apply SIM sources?"

msgid "正在应用卡源组合…"
msgstr "Applying SIM sources…"

msgid "卡源组合已保存"
msgstr "SIM sources saved"

msgid "此机型不支持双卡双待"
msgstr "This model does not support dual SIM dual standby"

msgid "TTL"
msgstr "TTL"

msgid "自动跟随上网卡"
msgstr "Follow data SIM automatically"

msgid "当前上网卡状态暂不可用"
msgstr "The current data SIM is temporarily unavailable"

msgid "来电提醒"
msgstr "Incoming call alerts"

msgid "转发来电提醒"
msgstr "Forward incoming call alerts"

msgid "默认关闭。两个槽位的来电按当前配置模式转发，包含卡源和来电号码；每通电话只提醒一次。"
msgstr "Off by default. Calls on both slots use the selected forwarding mode, including the SIM source and caller number. One alert per call."

msgid "eSIM 管理"
msgstr "eSIM management"

# SMS regular expression filters
msgid "正则筛选（可选）"
msgstr "Regular expression filters (optional)"

msgid "号码和正文的筛选须同时通过。仅影响新收到的短信，不影响电源或来电通知。"
msgstr "Both number and message filters must pass. Applies only to new incoming SMS, not power or incoming-call alerts."

msgid "号码筛选"
msgstr "Number filter"

msgid "正文筛选"
msgstr "Message filter"

msgid "关闭筛选"
msgstr "Filter off"

msgid "黑名单：匹配则不转发"
msgstr "Blocklist: do not forward matches"

msgid "白名单：仅匹配才转发"
msgstr "Allowlist: forward matches only"

msgid "号码正则 · 每行一条"
msgstr "Number expressions · one per line"

msgid "正文正则 · 每行一条"
msgstr "Message expressions · one per line"

msgid "忽略英文字母大小写"
msgstr "Ignore letter case"

msgid "每项最多 32 条，每条最多 512 字节。同项内任一行匹配即命中；白名单至少填写一条。"
msgstr "Up to 32 expressions per field, 512 bytes each. Any matching line counts; an allowlist needs at least one expression."

msgid "使用 POSIX 扩展正则，不加 / 分隔符；数字用 [0-9]。匹配原始号码（包含 +）和完整正文，点号可跨行。"
msgstr "Use POSIX extended expressions without / delimiters; use [0-9] for digits. Matches the original number (including +) and full message; dot can cross line breaks."

msgid "号码正则表达式无效"
msgstr "Invalid number expression"

msgid "正文正则表达式无效"
msgstr "Invalid message expression"

msgid "号码白名单至少填写一条正则"
msgstr "The number allowlist needs at least one expression"

msgid "正文白名单至少填写一条正则"
msgstr "The message allowlist needs at least one expression"

msgid "短信筛选规则无效"
msgstr "Invalid SMS filter rules"

msgid "正则条数或长度超过上限"
msgstr "Too many expressions or an expression is too long"

msgid "第 %d 行"
msgstr "Line %d"

msgid "旧版号码与关键词黑名单已停用；如需继续拦截，请在下方正则筛选中设置。"
msgstr "Legacy number and keyword blocklists are inactive. Set the regex filters below to continue blocking."

msgid "蜂窝"
msgstr "Hücresel"

msgid "接入点 APN"
msgstr "Erişim noktaları (APN)"

msgid "网络锁定"
msgstr "Ağ kilitleri"

msgid "短信"
msgstr "SMS"

msgid "短信转发"
msgstr "SMS yönlendirme"

msgid "流量池"
msgstr "Veri paketi"

msgid "AT 终端"
msgstr "AT terminali"

msgid "适配设置"
msgstr "Bağdaştırıcı ayarları"

msgid "设备管理"
msgstr "Cihaz yönetimi"

msgid "CPU 设置"
msgstr "CPU ayarları"

msgid "SIM 卡管理"
msgstr "SIM yönetimi"

msgid "电池与电量"
msgstr "Pil ve güç"

msgid "电池历史"
msgstr "Pil geçmişi"

msgid "电池使用时间"
msgstr "Pilde geçen süre"

msgid "预估续航"
msgstr "Tahmini kalan süre"

msgid "自上次充满"
msgstr "Son tam şarjdan beri"

msgid "自上次充电"
msgstr "Son şarjdan beri"

msgid "24 小时"
msgstr "24 saat"

msgid "7 天"
msgstr "7 gün"

msgid "小时"
msgstr "sa"

msgid "分钟"
msgstr "dk"

msgid "已连接电源，未充电"
msgstr "Güce bağlı, şarj olmuyor"

msgid "正在充电或已充满"
msgstr "Şarj oluyor veya dolu"

msgid "电池放电功率"
msgstr "Pilden çekilen güç"

msgid "时间区间"
msgstr "Zaman aralığı"

msgid "每分钟记录，保留最近 10 天；关机或缺失时段留空。功率和电流为电池净值，不是充电器输入值。"
msgstr "Dakikada bir kaydedilir, 10 gün saklanır. Kapalı veya eksik dönemler boş kalır. Güç ve akım, şarj girişi değil net pil değerleridir."

msgid "未检测到电池"
msgstr "Pil algılanmadı"

msgid "暂无历史记录，采集后自动显示"
msgstr "Henüz geçmiş yok; yeni ölçümler otomatik görünür"

msgid "电池记录读取失败，请稍后重试"
msgstr "Pil geçmişi okunamadı; biraz sonra yeniden deneyin"

msgid "连接电源时不估算续航"
msgstr "Güce bağlıyken tahmin edilmez"

msgid "放电记录不足，暂不估算"
msgstr "Daha fazla deşarj geçmişi gerekiyor"

msgid "按最近放电速度估算"
msgstr "Son deşarj hızına göre"

msgid "暂无记录"
msgstr "Ölçüm yok"

msgid "已更新"
msgstr "Güncellendi"

msgid "2内置卡 + 2插拔卡"
msgstr "2 dahili SIM + 2 çıkarılabilir SIM"

msgid "2插拔卡"
msgstr "2 çıkarılabilir SIM"

msgid "射频、锁定及 AT 查看仍按两个逻辑卡槽控制。"
msgstr "Radyo, kilitler ve AT görünümleri iki mantıksal SIM yuvasını kullanır."

msgid "卡源组合"
msgstr "SIM kaynak birleşimi"

msgid "卡源"
msgstr "SIM kaynağı"

msgid "分别选择两个逻辑栈接入的卡源，重启后保留。卡源选择不改变默认上网卡或射频开关。"
msgstr "Her mantıksal yığının SIM kaynağını seçin. Yeniden başlatmada korunur; varsayılan veri SIM’i veya radyo anahtarları değişmez."

msgid "应用卡源组合"
msgstr "SIM kaynaklarını uygula"

msgid "应用卡源组合？"
msgstr "SIM kaynakları uygulansın mı?"

msgid "正在应用卡源组合…"
msgstr "SIM kaynakları uygulanıyor…"

msgid "卡源组合已保存"
msgstr "SIM kaynakları kaydedildi"

msgid "此机型不支持双卡双待"
msgstr "Bu model çift SIM çift beklemeyi desteklemiyor"

msgid "TTL"
msgstr "TTL"

msgid "自动跟随上网卡"
msgstr "Veri SIM kartını otomatik izle"

msgid "当前上网卡状态暂不可用"
msgstr "Geçerli veri SIM durumu geçici olarak kullanılamıyor"

msgid "来电提醒"
msgstr "Gelen arama bildirimleri"

msgid "转发来电提醒"
msgstr "Gelen arama bildirimlerini yönlendir"

msgid "默认关闭。两个槽位的来电按当前配置模式转发，包含卡源和来电号码；每通电话只提醒一次。"
msgstr "Varsayılan olarak kapalıdır. İki yuvanın aramaları, SIM kaynağı ve arayan numarasıyla seçilen moda göre yönlendirilir. Her arama için bir bildirim gönderilir."

msgid "eSIM 管理"
msgstr "eSIM yönetimi"

# SMS regular expression filters
msgid "正则筛选（可选）"
msgstr "Düzenli ifade filtreleri (isteğe bağlı)"

msgid "号码和正文的筛选须同时通过。仅影响新收到的短信，不影响电源或来电通知。"
msgstr "Numara ve mesaj filtrelerinin ikisi de geçmelidir. Yalnızca yeni SMS’lere uygulanır; güç ve arama bildirimlerini etkilemez."

msgid "号码筛选"
msgstr "Numara filtresi"

msgid "正文筛选"
msgstr "Mesaj filtresi"

msgid "关闭筛选"
msgstr "Filtre kapalı"

msgid "黑名单：匹配则不转发"
msgstr "Engelleme listesi: eşleşenleri yönlendirme"

msgid "白名单：仅匹配才转发"
msgstr "İzin listesi: yalnızca eşleşenleri yönlendir"

msgid "号码正则 · 每行一条"
msgstr "Numara ifadeleri · her satıra bir tane"

msgid "正文正则 · 每行一条"
msgstr "Mesaj ifadeleri · her satıra bir tane"

msgid "忽略英文字母大小写"
msgstr "Büyük/küçük harfi yok say"

msgid "每项最多 32 条，每条最多 512 字节。同项内任一行匹配即命中；白名单至少填写一条。"
msgstr "Her alan için en fazla 32 ifade, ifade başına 512 bayt. Herhangi bir satırın eşleşmesi yeterlidir; izin listesinde en az bir ifade olmalıdır."

msgid "使用 POSIX 扩展正则，不加 / 分隔符；数字用 [0-9]。匹配原始号码（包含 +）和完整正文，点号可跨行。"
msgstr "/ ayırıcıları olmadan POSIX genişletilmiş ifadeler kullanın; rakamlar için [0-9] yazın. Özgün numara (+ dahil) ve mesajın tamamı eşleştirilir; nokta satır sonlarıyla da eşleşir."

msgid "号码正则表达式无效"
msgstr "Geçersiz numara ifadesi"

msgid "正文正则表达式无效"
msgstr "Geçersiz mesaj ifadesi"

msgid "号码白名单至少填写一条正则"
msgstr "Numara izin listesinde en az bir ifade olmalıdır"

msgid "正文白名单至少填写一条正则"
msgstr "Mesaj izin listesinde en az bir ifade olmalıdır"

msgid "短信筛选规则无效"
msgstr "Geçersiz SMS filtre kuralları"

msgid "正则条数或长度超过上限"
msgstr "Çok fazla ifade var veya bir ifade çok uzun"

msgid "第 %d 行"
msgstr "Satır %d"

msgid "旧版号码与关键词黑名单已停用；如需继续拦截，请在下方正则筛选中设置。"
msgstr "Eski numara ve anahtar sözcük engelleme listeleri devre dışıdır. Engellemeye devam etmek için aşağıdaki düzenli ifade filtrelerini ayarlayın."
